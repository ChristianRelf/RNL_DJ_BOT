# ---------------------------------------------------------------------------
# Playback bot — "deck"  (https://discord.com/developers/applications)
# ---------------------------------------------------------------------------
# The Discord account the room hears. This is the default; an owner can add
# further bots from /deck/tools and switch between them without a restart.
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# Only used once, to import an existing single-guild db.json on the first start
# after upgrading. Rigs live in the database now and are created from the portal
# or the onboarding wizard; unset this afterwards.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Sign-in application — "deck auth"
# ---------------------------------------------------------------------------
# Signing in is kept separate from playback, so the account people log in
# through does not change when the bot on air does. Leave these unset to run
# both from the playback application above, which is how a single-app install
# works.
#
# AUTH_BOT_TOKEN is only used to read guild membership and roles. Whichever
# token ends up serving that job has to belong to a bot that is in the guild:
# if you have not invited the auth application's bot, leave it unset and the
# playback token covers it.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_BOT_TOKEN=

# The OAuth2 client secret. Required only when AUTH_CLIENT_SECRET is unset.
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# ---------------------------------------------------------------------------
# Access gating
# ---------------------------------------------------------------------------
# Seeds the roles of the guild imported from db.json. Per-rig roles are chosen
# during onboarding and stored in the database; these are not read again.
DJ_ROLE_IDS=

# Comma separated role IDs that may force-take control, evict DJs and delete
# any media. Optional.
ADMIN_ROLE_IDS=

# Comma separated user IDs that are always admins. Optional.
ADMIN_USER_IDS=

# Comma separated user IDs that run the platform: the portal, the allowlist,
# the bot pool, every rig. A step above a guild admin, who can force-take the
# decks in one server and nothing else. There has to be at least one, or nobody
# can let the first person in.
#
# OWNER_USER_IDS is still read under its old name so an existing install does
# not lose its administrator on upgrade.
PLATFORM_ADMIN_IDS=

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
PORT=7403
# Public origin the browser reaches this app on. Must match the OAuth2 redirect
# URI registered in the Discord developer portal, which is:
#   <PUBLIC_URL>/api/auth/callback
#
# Behind a TLS reverse proxy set the https origin here, not the internal port.
# Session cookies are marked Secure automatically when this starts with https.
#   production:  PUBLIC_URL=https://deck.ronation.live
#   local dev:   PUBLIC_URL=http://localhost:5173
PUBLIC_URL=http://localhost:7403

# The owner portal, matched against the Host header on the same server.
#   production:  PORTAL_HOST=portal.deck.ronation.live
PORTAL_HOST=

# Scopes the session cookie so one sign-in covers the console and the portal.
# Set it to the parent of both — deck.ronation.live covers
# portal.deck.ronation.live. Leave empty for localhost, where a host-only
# cookie is what you want.
COOKIE_DOMAIN=
# Random string, >=32 chars. Signs session cookies. Rotating it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-please

# ---------------------------------------------------------------------------
# Storage / limits
# ---------------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Control lock
# ---------------------------------------------------------------------------
# Control is released automatically after this many seconds without any
# controller input (0 disables the idle timeout).
CONTROL_IDLE_TIMEOUT_S=180
# Grace period after the controller's browser disconnects before control drops.
CONTROL_DISCONNECT_GRACE_S=20

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Path to ffmpeg/ffprobe if not on PATH (the docker image ships them).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional extras. Each one costs a feature when missing, never the mix:
#   yt-dlp  — importing YouTube links from the tools page
#   aubio   — reading the beat grid off a track at upload, which is what
#             beatmatching, quantised loops and tempo-locked effects need.
#             Install it later and re-analyse from the pool; nothing is lost.
YTDLP_PATH=yt-dlp
AUBIO_PATH=aubio
LOG_LEVEL=info
