# ---------------------------------------------------------------------------
# deck - the Discord application  (https://discord.com/developers/applications)
# ---------------------------------------------------------------------------
# One application does everything: it is the bot people invite, the account the
# room hears by default, what /dj is registered against, and the token that
# answers "is this person in the server, and what roles do they have?".
#
# A rig can be pointed at a *different* playback account from its tools page.
# Signing in always stays on this one, so who is allowed in never changes when
# the account the room hears does.
#
# No privileged intents are needed. It wants Connect, Speak and View Channel -
# the onboarding wizard builds that invite itself.
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
PORT=7403

# Public origin the browser reaches the console on. Two redirect URIs have to be
# registered against the application above, both derived from this:
#   <PUBLIC_URL>/api/auth/callback      signing in
#   <PUBLIC_URL>/api/onboard/callback   adding deck to a server
#
# Behind a TLS reverse proxy set the https origin here, not the internal port.
# Session cookies are marked Secure automatically when this starts with https.
#   production:  PUBLIC_URL=https://deck.ronation.live
#   local dev:   PUBLIC_URL=http://localhost:5173
PUBLIC_URL=http://localhost:7403

# Hostname the owner portal answers on, matched against the Host header. It
# needs a DNS record and a Caddy site block (see deploy/Caddyfile) but not a
# second deployment. Left empty the portal is only at <PUBLIC_URL>/portal.
#   production:  PORTAL_HOST=portal.deck.ronation.live
PORTAL_HOST=

# Scopes the session cookie so one sign-in covers the console and the portal.
# Set it to the parent of both - deck.ronation.live covers
# portal.deck.ronation.live. Leave empty for localhost, where a host-only cookie
# is what you want.
#   production:  COOKIE_DOMAIN=deck.ronation.live
COOKIE_DOMAIN=

# Random string, >=32 chars. Signs session cookies, and derives the key that
# encrypts stored bot tokens. Rotating it signs everyone out *and* makes any
# added playback bot's token unreadable - the right blast radius if it has
# leaked, but it means re-pasting those tokens.
SESSION_SECRET=change-me-to-a-long-random-string-please

# ---------------------------------------------------------------------------
# Who runs the platform
# ---------------------------------------------------------------------------
# Comma separated Discord user IDs. These accounts reach the portal: the rig
# list, the allowlist that decides who may sign in at all, and the shared pool
# of playback bots. A step above a guild admin, who can force-take the decks in
# one server and nothing else.
#
# There has to be at least one, or nobody can let the first person in. Also read
# under its old name OWNER_USER_IDS, so an existing install does not lose its
# administrator on upgrade.
PLATFORM_ADMIN_IDS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Holds deck.db, and nothing else that matters. No audio is ever stored here -
# tracks play straight off the folder on the DJ's own machine.
#
# media/ and pcm/ only ever hold files from the legacy upload route, which
# existing libraries still play from.
DATA_DIR=./data

# Per file, on that legacy upload route. Nothing else uploads.
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Control lock
# ---------------------------------------------------------------------------
# Control is released automatically after this many seconds without any
# controller input (0 disables the idle timeout).
CONTROL_IDLE_TIMEOUT_S=180
# Grace period after the controller's browser disconnects before control drops.
CONTROL_DISCONNECT_GRACE_S=20

# ---------------------------------------------------------------------------
# Upgrading from a single-guild install
# ---------------------------------------------------------------------------
# Rigs live in the database and are created from the onboarding wizard. These
# four are read *once*, on the first start after upgrading, to import an
# existing data/db.json into one guild and seed its roles. Unset them after.
#
# The import runs once and leaves db.json where it is.
DISCORD_GUILD_ID=
DJ_ROLE_IDS=
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# External binaries
# ---------------------------------------------------------------------------
# ffmpeg is only ever used off the realtime path - the legacy upload route, and
# preparing audio for beat detection. The docker image ships it.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional. Each costs a feature when missing, never the mix:
#   aubio   - reading the beat grid off a track, which is what beatmatching,
#             quantised loops and tempo-locked effects need. In the image.
#   yt-dlp  - importing links from the tools page. NOT in the image; install it
#             in the container yourself if you want that feature.
AUBIO_PATH=aubio
YTDLP_PATH=yt-dlp

LOG_LEVEL=info
