# RNL DJ — Caddy site blocks for deck.ronation.live and its portal.
#
# These go into whichever Caddyfile is already serving this box. Caddy will not
# present a certificate for a hostname it has no site block for, and a browser
# meeting that reports ERR_SSL_PROTOCOL_ERROR rather than anything about the
# name being unknown — so a missing block looks like a broken certificate.
#
# Caddy runs in a container here, alongside the app, both attached to the shared
# `edge` network. That is why the upstream is the container name and not
# 127.0.0.1: inside the Caddy container, loopback is Caddy itself.
#
#   append to the Caddyfile that container mounts, then:
#   docker exec <caddy-container> caddy validate --config /etc/caddy/Caddyfile
#   docker exec <caddy-container> caddy reload   --config /etc/caddy/Caddyfile
#
# Caddy provisions and renews the certificates itself; both names need an
# A/AAAA record pointing at this box, and ports 80 and 443 open, or the ACME
# challenge will fail.

deck.ronation.live {
	encode zstd gzip

	# Track uploads go through this proxy. Keep the ceiling comfortably above
	# MAX_UPLOAD_MB in .env or large files will be cut off with a 413 before
	# the app ever sees them.
	request_body {
		max_size 200MB
	}

	# The container name, resolved over the shared `edge` network. If you run
	# Caddy on the host instead, this becomes 127.0.0.1:7403 and the app's
	# published port is what serves it.
	reverse_proxy rnl-dj-bot:7403 {
		# Socket.IO's websocket upgrade is handled automatically. Disabling
		# response buffering keeps state and meter frames flowing in realtime
		# rather than being held back by the proxy.
		flush_interval -1

		# Long uploads must not be cut short mid-transfer.
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}

# Access logs go to the journal by default: journalctl -u caddy -f
# To log this site to its own file, make sure the directory exists and is
# writable by the caddy user first, otherwise the whole config fails to load:
#   mkdir -p /var/log/caddy && chown caddy:caddy /var/log/caddy
# then add inside the site block:
#   log {
#   	output file /var/log/caddy/deck.ronation.live.log
#   	format json
#   }

# ---------------------------------------------------------------------------
# The owner portal.
#
# A separate site block on the same backend rather than a wildcard: two named
# hosts each get an ordinary certificate over HTTP-01, where *.deck.ronation.live
# would need DNS-01 and a provider API token sitting on this box.
#
# Optional. Without it the portal is still reachable at deck.ronation.live/portal.
#
# The session cookie is issued with Domain=deck.ronation.live (COOKIE_DOMAIN in
# .env), which is why one sign-in covers both hosts.
# ---------------------------------------------------------------------------
portal.deck.ronation.live {
	encode zstd gzip

	reverse_proxy rnl-dj-bot:7403 {
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
